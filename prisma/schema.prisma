generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only for `prisma migrate`/`db push` — Supabase's transaction-mode
  // pooler (used at runtime for serverless-friendly connection pooling)
  // doesn't support the prepared statements the schema engine needs.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (NextAuth.js) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain ----------

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  websites       Website[]
  socialAccounts SocialAccount[]
  generatedPosts GeneratedPost[]
  agentRuns      AgentRun[]
  settings       AgentSettings?
  brandProfile   BrandProfile?
  notifications  Notification[]
}

/** Raw connected website + what the agent scraped/inferred from it. */
model Website {
  id             String          @id @default(cuid())
  userId         String
  url            String
  name           String?
  niche          String?
  products       Json?
  analysis       Json?
  analyzedAt     DateTime?
  isPrimary      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfiles  BrandProfile[]
  generatedPosts GeneratedPost[]
  agentRuns      AgentRun[]
}

enum Language {
  EN
  UR
  BOTH
}

enum PostType {
  IMAGE
  CAROUSEL
  REEL
}

/**
 * User-curated brand identity layer, editable independently of whatever the
 * website scrape produced. This is what every content-generation prompt
 * reads from.
 */
model BrandProfile {
  id                  String     @id @default(cuid())
  userId              String     @unique
  websiteId           String?
  brandVoice          String?
  tone                String?
  targetAudience      String?
  uniqueSellingPoints String[]
  languagePreference  Language   @default(EN)
  contentTypes        PostType[] @default([IMAGE])
  dos                 String?
  donts               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  website             Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

model SocialAccount {
  id           String         @id @default(cuid())
  userId       String
  platform     SocialPlatform
  accountId    String
  accountName  String?
  avatarUrl    String?
  accessToken  String         @db.Text
  refreshToken String?        @db.Text
  expiresAt    DateTime?
  metadata     Json?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
}

enum PostStatus {
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
  REGENERATING
}

/**
 * `captions` and `reelScript` are stored as JSON rather than exploded into
 * columns since their shape depends on postType and language preference.
 * Shared TypeScript types for both live in lib/ai/types.ts:
 *   captions:   CaptionSet   = { facebook: Localized, instagram: Localized, linkedin: Localized }
 *   reelScript: ReelScript   = { hook, fullScript, scenes: ReelScene[] }
 * where Localized = { en?: string, ur?: string }
 */
model GeneratedPost {
  id              String     @id @default(cuid())
  userId          String
  websiteId       String?
  agentRunId      String?
  status          PostStatus @default(PENDING_APPROVAL)
  postType        PostType   @default(IMAGE)
  theme           String?
  imageUrl        String?
  imagePrompt     String?
  captions        Json?
  reelScript      Json?
  researchSummary String?
  platforms       String[]
  hashtags        String[]
  rejectionReason String?
  approvedAt      DateTime?
  publishedAt     DateTime?
  publishResults  Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  website         Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  agentRun        AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  media           PostMedia[]
}

/** Carousel slides (ordered). Unused for IMAGE/REEL post types. */
model PostMedia {
  id          String        @id @default(cuid())
  postId      String
  order       Int
  imageUrl    String?
  imagePrompt String?
  caption     Json?
  post        GeneratedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model AgentRun {
  id             String          @id @default(cuid())
  userId         String
  websiteId      String?
  status         AgentRunStatus  @default(RUNNING)
  trigger        String
  postsGenerated Int             @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  steps          Json?
  error          String?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  website        Website?        @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  posts          GeneratedPost[]
}

model AgentSettings {
  id             String    @id @default(cuid())
  userId         String    @unique
  isActive       Boolean   @default(true)
  frequencyHours Int       @default(6)
  postsPerRun    Int       @default(2)
  notifyOnReady  Boolean   @default(true)
  autoApprove    Boolean   @default(false)
  lastRunAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
