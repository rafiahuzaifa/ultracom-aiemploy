# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signalforge"
# If using Supabase: DATABASE_URL should be the "Transaction pooler" URI
# (port 6543, with ?pgbouncer=true) for serverless-friendly runtime pooling,
# and DIRECT_URL should be the "Session pooler" or direct URI (port 5432) —
# `prisma migrate`/`db push` use DIRECT_URL since the transaction pooler
# doesn't support the prepared statements the schema engine needs.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/signalforge"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"
# Generate with: openssl rand -hex 32 (must be exactly 32 bytes / 64 hex chars)
ENCRYPTION_KEY="32-byte-hex-key-for-token-encryption"

# ---------- Login (NextAuth Google OAuth) ----------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- AI providers ----------
# Which provider generates captions/research JSON and which generates images.
# Text supported values: "gemini" | "openai"
# Image supported values: "pollinations" (free, no key/billing needed) | "gemini" | "openai"
AI_TEXT_PROVIDER="gemini"
AI_IMAGE_PROVIDER="pollinations"

# Google Gemini (default text provider) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.6-flash"
# Gemini image generation requires a billing-enabled Google Cloud project
# (free tier quota is 0) — use AI_IMAGE_PROVIDER=pollinations to avoid this.
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# OpenAI (alternate provider — set AI_TEXT_PROVIDER/AI_IMAGE_PROVIDER=openai to use)
# Image generation (gpt-image-1) requires OpenAI billing/credits.
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o"

# ---------- Website analysis ----------
# Optional: without this, a lightweight fetch + cheerio scrape is used instead.
FIRECRAWL_API_KEY=""

# ---------- Background jobs (Inngest) ----------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------- File storage (generated ad images) ----------
# Required for Facebook/Instagram publishing, which need a public image URL.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# ---------- Social platform APIs ----------
# Meta (Facebook Pages + Instagram Business) — https://developers.facebook.com/apps
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn (Company Pages) — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
